#!/bin/sh
# 커밋 직전에 자동으로 도는 검사: 올리려는 내용에 API 열쇠 같은 비밀값이나 .env 파일, 압축 파일이 있으면 커밋을 막는다.
# 켜는 법(한 번만):  npm run hooks      (npm install 을 하면 저절로 켜진다)
node scripts/check-secrets.mjs --staged
status=$?
if [ "$status" -ne 0 ]; then
  echo ""
  echo "커밋을 멈췄어요. 위에 적힌 파일에서 비밀값을 지우고 다시 담아(git add) 주세요. .env 파일이나 압축 파일은 'git rm --cached <파일>'로 빼 주세요."
  echo "검사를 건너뛰는 --no-verify 는 쓰지 마세요. 자세한 것은 docs/SECURITY.md 에 있어요."
  exit 1
fi
exit 0
