# 방봄 로컬 서버 설정 · 이 파일은 절대 공유·커밋하지 마세요
# 1) 아래 BAZE_API_KEY= 뒤에 BAZE에서 받은 키를 붙여 넣고 저장
# 2) 시연하기.cmd 를 더블클릭 → 키가 자동으로 암호화되어 BAZE_API_KEY_ENC로 옮겨지고 이 칸은 비워집니다
BAZE_API_KEY=
BAZE_API_KEY_ENC=
# 쓸 모델 (python server.py --models 로 목록 확인 후 소형 모델 이름으로 바꾸세요)
BAZE_MODEL=claude-haiku-5-5
BAZE_BASE_URL=https://api.baze.co/v1/gateway
LLM_TIMEOUT=12
